+
+// applyRouteInputRules adds INPUT chain ACCEPT rules for non-masqueraded route
+// networks. Without SNAT, traffic from these networks arrives with its original
+// source IP intact, which is not a known NetBird peer IP. The default INPUT chain
+// drops such traffic because it only allows known peer IPs. By adding ACCEPT rules
+// for non-masqueraded route networks, we allow site-to-VPN traffic to reach local
+// services on this peer without requiring SNAT.
+func (d *DefaultManager) applyRouteInputRules(routes []*mgmProto.Route) {
+	newNets := make(map[netip.Prefix]struct{})
+	for _, route := range routes {
+		if route.Masquerade {
+			continue
+		}
+		if len(route.Network) == 0 {
+			continue
+		}
+		prefix, err := netip.ParsePrefix(route.Network)
+		if err != nil {
+			log.Warnf("failed to parse route network %s for input rule: %v", route.Network, err)
+			continue
+		}
+		prefix = prefix.Masked()
+		if prefix.Bits() == 0 {
+			continue
+		}
+		newNets[prefix] = struct{}{}
+		if _, exists := d.routeInputNets[prefix]; !exists {
+			if err := d.firewall.AddRouteInputRule(prefix); err != nil {
+				log.Errorf("failed to add route input rule for %s: %v", prefix, err)
+			}
+		}
+	}
+	for prefix := range d.routeInputNets {
+		if _, exists := newNets[prefix]; !exists {
+			if err := d.firewall.RemoveRouteInputRule(prefix); err != nil {
+				log.Errorf("failed to remove route input rule for %s: %v", prefix, err)
+			}
+		}
+	}
+	d.routeInputNets = newNets
+}
